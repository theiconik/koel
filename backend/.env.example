SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk — copy from your Clerk dashboard → JWT Templates → Issuer URL
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
# Recommended for production: expected aud claim for API tokens.
# Leave blank only for local dev if your Clerk token/template has no audience.
CLERK_JWT_AUDIENCE=koel-api
# Optional: comma-separated Clerk azp authorized parties, usually frontend origins.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxx
# Optional: pin a specific ElevenLabs agent branch/environment
ELEVENLABS_BRANCH_ID=
ELEVENLABS_ENVIRONMENT=production

OPENROUTER_API_KEY=your-openrouter-api-key
# Pick any model available on openrouter.ai
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gemini fallback for LLM enrichment when OpenRouter fails after retries
# Also used for gemini-embedding-001 survey-response embeddings.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Base URL of the Next.js frontend — used to build shareUrl
APP_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (defaults to APP_URL)
CORS_ORIGINS=http://localhost:3000

# Response processing worker
RESPONSE_JOB_BATCH_SIZE=1
RESPONSE_JOB_LEASE_SECONDS=900
RESPONSE_JOB_POLL_INTERVAL_SECONDS=5
RESPONSE_JOB_RETRY_DELAY_SECONDS=60
RESPONSE_JOB_RETRY_MAX_DELAY_SECONDS=900

# Logging: level = DEBUG | INFO | WARNING | ERROR; format = text | json
LOG_LEVEL=INFO
LOG_FORMAT=text

# OpenTelemetry tracing
# Disabled by default for local dev. When enabled without an OTLP endpoint,
# spans are written to stdout with the console exporter.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=koel-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated key=value headers for OTLP auth. Do not commit real tokens.
OTEL_EXPORTER_OTLP_HEADERS=
# 0.0 disables sampling; 1.0 samples every trace.
OTEL_TRACES_SAMPLE_RATE=1.0
